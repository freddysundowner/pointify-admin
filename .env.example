# ReggyPOS Platform Admin configuration. Copy to .env and fill in.

# URL of your ReggyPOS API, without a trailing slash
REGGYPOS_API_URL=http://localhost:3000

# Port and interface the admin listens on (use HOST=127.0.0.1 behind Nginx).
# Avoid port 5000 on macOS: it is used by AirPlay Receiver.
PORT=5050
HOST=0.0.0.0
